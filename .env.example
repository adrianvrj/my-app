# Cavos credentials — get these from https://cavos.xyz/dashboard
# The wallet app at / (app/_wallet) and the self-hosted /approve-device page
# use these for login + gasless deploy/execute.

# Your Cavos App ID (from the dashboard's app settings).
NEXT_PUBLIC_CAVOS_APP_ID=

# Cavos paymaster API key (sponsors gas for deploy + execute on the device-signer account).
NEXT_PUBLIC_CAVOS_PAYMASTER_API_KEY=
